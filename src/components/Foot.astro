---
import { navLinks, footTractaments, i18nCommon, hoursRows, tr, TEL, MAIL } from "../lib/site";
---
<footer class="foot">
  <div class="wrap foot__grid">
    <div class="foot__brand">
      <a class="brand brand--light" href="/">
        <span class="brand__mark" aria-hidden="true"></span>
        <span class="brand__word">FisioyMés</span>
      </a>
      <p class="foot__tag" {...tr(i18nCommon.footTag)}>{i18nCommon.footTag.ca}</p>
      <div class="foot__social">
        <a href="https://www.facebook.com/fisioymes/" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 9H15V6h-1.5C11.6 6 10 7.6 10 9.5V11H8v3h2v7h3v-7h2.1l.4-3H13v-1.2c0-.5.3-.8.8-.8Z"/></svg>
        </a>
        <a href="https://www.instagram.com/fisioymes/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2c-2.7 0-3.06.01-4.12.06-1.06.05-1.79.22-2.43.47a4.9 4.9 0 0 0-1.77 1.15A4.9 4.9 0 0 0 2.53 5.45c-.25.64-.42 1.37-.47 2.43C2.01 8.94 2 9.3 2 12s.01 3.06.06 4.12c.05 1.06.22 1.79.47 2.43.26.66.6 1.22 1.15 1.77.55.55 1.11.9 1.77 1.15.64.25 1.37.42 2.43.47C8.94 21.99 9.3 22 12 22s3.06-.01 4.12-.06c1.06-.05 1.79-.22 2.43-.47a4.9 4.9 0 0 0 1.77-1.15c.55-.55.9-1.11 1.15-1.77.25-.64.42-1.37.47-2.43.05-1.06.06-1.42.06-4.12s-.01-3.06-.06-4.12c-.05-1.06-.22-1.79-.47-2.43a4.9 4.9 0 0 0-1.15-1.77A4.9 4.9 0 0 0 18.55 2.53c-.64-.25-1.37-.42-2.43-.47C15.06 2.01 14.7 2 12 2Zm0 1.8c2.67 0 2.99.01 4.04.06.98.04 1.5.2 1.86.34.47.18.8.4 1.15.75.35.35.57.68.75 1.15.14.36.3.88.34 1.86.05 1.05.06 1.37.06 4.04s-.01 2.99-.06 4.04c-.04.98-.2 1.5-.34 1.86-.18.47-.4.8-.75 1.15-.35.35-.68.57-1.15.75-.36.14-.88.3-1.86.34-1.05.05-1.37.06-4.04.06s-2.99-.01-4.04-.06c-.98-.04-1.5-.2-1.86-.34a3.1 3.1 0 0 1-1.15-.75 3.1 3.1 0 0 1-.75-1.15c-.14-.36-.3-.88-.34-1.86C3.81 14.99 3.8 14.67 3.8 12s.01-2.99.06-4.04c.04-.98.2-1.5.34-1.86.18-.47.4-.8.75-1.15.35-.35.68-.57 1.15-.75.36-.14.88-.3 1.86-.34C9.01 3.81 9.33 3.8 12 3.8Zm0 3.05a5.15 5.15 0 1 0 0 10.3 5.15 5.15 0 0 0 0-10.3Zm0 8.5a3.35 3.35 0 1 1 0-6.7 3.35 3.35 0 0 1 0 6.7Zm5.35-8.7a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z"/></svg>
        </a>
      </div>
      <img class="foot__kit" src="/demo-fisioymes-v2/images/kit-digital-banner.png" alt="Financiado por el Gobierno de España, red.es, Kit Digital y la Unión Europea (NextGenerationEU)" loading="lazy" />
    </div>
    <div>
      <p class="foot__heading" {...tr(i18nCommon.footTreatments)}>{i18nCommon.footTreatments.ca}</p>
      <ul class="foot__nav">
        {footTractaments.map((l) => <li><a href={l.href} data-ca-text={l.ca} data-es-text={l.es}>{l.ca}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="foot__heading" {...tr(i18nCommon.footMore)}>{i18nCommon.footMore.ca}</p>
      <ul class="foot__nav">
        {navLinks.map((l) => <li><a href={l.href} data-ca-text={l.ca} data-es-text={l.es}>{l.ca}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="foot__heading" {...tr(i18nCommon.footHours)}>{i18nCommon.footHours.ca}</p>
      <ul class="foot__hours">
        {hoursRows.map((r) => (
          <li><span data-ca-text={r.day.ca} data-es-text={r.day.es}>{r.day.ca}</span><span>{r.hours}</span></li>
        ))}
      </ul>
      <p class="foot__contact" style="margin-top:1.1rem">
        <a href={TEL}>664 76 25 70</a><br /><a href={MAIL}>info@fisioymes.com</a>
      </p>
    </div>
  </div>
  <div class="wrap">
    <div class="foot__legal">
      <a href="/privadesa/" data-ca-text={i18nCommon.legalPrivacy.ca} data-es-text={i18nCommon.legalPrivacy.es}>{i18nCommon.legalPrivacy.ca}</a>
      <a href="/avis-legal/" data-ca-text={i18nCommon.legalNotice.ca} data-es-text={i18nCommon.legalNotice.es}>{i18nCommon.legalNotice.ca}</a>
      <a href="/cookies/" data-ca-text={i18nCommon.legalCookies.ca} data-es-text={i18nCommon.legalCookies.es}>{i18nCommon.legalCookies.ca}</a>
    </div>
    <p class="foot__copyright">© 2026 FisioyMés. Tots els drets reservats.</p>
    <p class="foot__demo" {...tr(i18nCommon.footDemo)}>{i18nCommon.footDemo.ca}</p>
  </div>
</footer>
