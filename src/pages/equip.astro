const i18n = {
  h1: { ca: "Equip", es: "Equipo" },
  intro: {
    ca: "A Fisioymés treballem en equip per oferir una atenció de fisioteràpia personalitzada i de qualitat. Compartim coneixement, experiència clínica i diferents enfocaments terapèutics per analitzar cada cas des d'una perspectiva global. Aquesta col·laboració entre professionals ens permet dissenyar plans de tractament adaptats a les necessitats de cada pacient, amb l'objectiu de millorar la seva salut, recuperar la funcionalitat i garantir el seu benestar.",
    es: "En Fisioymés trabajamos en equipo para ofrecer una atención de fisioterapia personalizada y de calidad. Compartimos conocimiento, experiencia clínica y diferentes enfoques terapéuticos para analizar cada caso desde una perspectiva global. Esta colaboración entre profesionales nos permite diseñar planes de tratamiento adaptados a las necesidades de cada paciente, con el objetivo de mejorar su salud, recuperar la funcionalidad y garantizar su bienestar.",
  },
};
---

<Layout title="Equip · FisioyMés">
  <Nav />

  <main id="top">
    <section class="team" aria-labelledby="team-h">
      <div class="wrap">
        <header class="sec-head sec-head--center" data-reveal>
          <h1 id="team-h" {...tr(i18n.h1)}>{i18n.h1.ca}</h1>
          <p {...tr(i18n.intro)}>{i18n.intro.ca}</p>
        </header>
        <div class="team__grid">
          {team.map((p) => (
            <article class="team__card" data-reveal>
              <div class="team__avatar" aria-hidden="true">{p.name.charAt(0)}</div>
              <h3>{p.name}</h3>
              <p class="team__role" {...tr(p.role)}>{p.role.ca}</p>
              <ul>
                {p.creds.map((c) => <li {...tr(c)}>{c.ca}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Foot />
  <SiteScripts />
</Layout>
